# Run from the repo root: doxygen docs/doxygen/Doxyfile
# (see docs/build.sh, which stages the input header first)
PROJECT_NAME           = "QuickIK"
PROJECT_BRIEF          = "C++ bindings"
OUTPUT_DIRECTORY       = docs/api/cpp
INPUT                  = docs/api/cpp-staging docs/doxygen/mainpage.md
USE_MDFILE_AS_MAINPAGE = docs/doxygen/mainpage.md
FILE_PATTERNS          = *.h
RECURSIVE              = NO
EXTRACT_ALL            = YES
EXCLUDE_SYMBOLS        = rust::*
WARN_IF_UNDOCUMENTED   = NO
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
QUIET                  = YES
